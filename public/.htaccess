# CJC Music — static site on Apache/Hostinger
# Routes are exported as <path>/index.html (Next.js trailingSlash), so Apache
# serves clean URLs natively via DirectoryIndex — no rewrite rules needed.

# Custom 404 page
ErrorDocument 404 /404.html

# Cache static assets (HTML is left uncached so content updates show immediately)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/x-icon          "access plus 1 year"
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2            "access plus 1 year"
</IfModule>

# Gzip/Brotli compression where available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
